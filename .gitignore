venv/
__pycache__/
*.pyc

# workspace/ (React+Vite app) — built fresh by deploy.sh on every deploy,
# never committed.
workspace/node_modules/
workspace/dist/

# Local dev sqlite DB for the auth/workspace tables (see _auth_db.py's docstring)
paisamap_dev.db

# Cross-process write lock for enrich_single.py / batch_enrich_hces.py
# (see paisamap-etl/etl/_filelock.py) — auto-created on demand, empty file.
paisamap-etl/data/.write.lock
# Large data files — download on demand via ETL scripts
paisamap-etl/data/raw/*.parquet
paisamap-etl/data/raw/wdi.parquet

# Pan-India RBI branch master export (136MB, exceeds GitHub's file size limit) —
# manually re-exported from https://data.rbi.org.in/DBIE/#/banking-outlet ;
# parse_rbi_branch_master.py derives the small committed rbi_branch_counts_india.csv from it.
paisamap-etl/data/reference/rbi_branch_master_india/

# All-India PIN code boundary RAW master (90MB, 19,312 features, uncompressed/
# unsimplified, Dept. of Posts via data.gov.in) — re-download per
# fetch_boundaries.py's docstring, used only as the input to the one-off
# mapshaper simplification pass. The *simplified* (~11MB) sibling file
# india_pincode_boundaries_simplified.geojson in the same directory IS
# committed — that's the actual reproducible national base layer
# fetch_boundaries.py reads on every run.
paisamap-etl/data/reference/pincode_boundary_master/All_India_pincode_Boundary-19312.geojson
